load("//tools:defaults.bzl", "ng_project")

package(default_visibility = ["//visibility:public"])

# Local addition (not upstream): Angular renderings of every qwik-material
# dev-app scenario, served under /qwik-parity/<component>/<scenario> so
# src/qwik-cdk-parity-tests can diff Angular vs Qwik DOM. See README.md.
ng_project(
    name = "qwik-parity",
    srcs = glob(["**/*.ts"]),
    # Plain-CSS `styleUrl`s referenced by component TS here (core.ts, for the typography/
    # elevation parity mirror) need to be visible to the Angular compiler's own file resolution.
    assets = glob(["**/*.css"]),
    deps = [
        "//:node_modules/@angular/common",
        "//:node_modules/@angular/core",
        "//:node_modules/@angular/forms",
        "//:node_modules/@angular/platform-browser",
        "//:node_modules/@angular/router",
        "//src/cdk/a11y",
        "//src/cdk/accordion",
        "//src/cdk/bidi",
        "//src/cdk/dialog",
        "//src/cdk/overlay",
        "//src/cdk/portal",
        "//src/cdk/stepper",
        "//src/cdk/table",
        "//src/cdk/tree",
        "//src/components-examples/private",
        "//src/material/autocomplete",
        "//src/material/badge",
        "//src/material/bottom-sheet",
        "//src/material/button",
        "//src/material/button-toggle",
        "//src/material/card",
        "//src/material/checkbox",
        "//src/material/chips",
        "//src/material/core",
        "//src/material/datepicker",
        "//src/material/dialog",
        "//src/material/divider",
        "//src/material/expansion",
        "//src/material/form-field",
        "//src/material/grid-list",
        "//src/material/icon",
        "//src/material/input",
        "//src/material/list",
        "//src/material/menu",
        "//src/material/paginator",
        "//src/material/progress-bar",
        "//src/material/progress-spinner",
        "//src/material/radio",
        "//src/material/select",
        "//src/material/sidenav",
        "//src/material/slide-toggle",
        "//src/material/slider",
        "//src/material/snack-bar",
        "//src/material/sort",
        "//src/material/stepper",
        "//src/material/table",
        "//src/material/tabs",
        "//src/material/timepicker",
        "//src/material/toolbar",
        "//src/material/tooltip",
        "//src/material/tree",
    ],
)
