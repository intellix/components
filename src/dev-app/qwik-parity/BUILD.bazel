load("//tools:defaults.bzl", "ng_project")

package(default_visibility = ["//visibility:public"])

# Local addition (not upstream): Angular renderings of every qwik-material
# dev-app scenario, served under /qwik-parity/<component>/<scenario> so
# src/qwik-cdk-parity-tests can diff Angular vs Qwik DOM. See README.md.
ng_project(
    name = "qwik-parity",
    srcs = glob(["**/*.ts"]),
    deps = [
        "//:node_modules/@angular/common",
        "//:node_modules/@angular/core",
        "//:node_modules/@angular/forms",
        "//:node_modules/@angular/platform-browser",
        "//:node_modules/@angular/router",
        "//src/cdk/dialog",
        "//src/cdk/overlay",
        "//src/cdk/portal",
        "//src/material/badge",
        "//src/material/button",
        "//src/material/button-toggle",
        "//src/material/card",
        "//src/material/core",
        "//src/material/dialog",
        "//src/material/divider",
        "//src/material/grid-list",
        "//src/material/icon",
        "//src/material/list",
        "//src/material/progress-bar",
        "//src/material/progress-spinner",
        "//src/material/toolbar",
    ],
)
