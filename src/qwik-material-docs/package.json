{
  "name": "qwik-material-docs",
  "private": true,
  "type": "module",
  "scripts": {
    "generate:api": "node scripts/generate-api.mjs",
    "generate:examples-source": "node scripts/generate-examples-source.mjs",
    "generate": "pnpm run generate:api && pnpm run generate:examples-source",
    "dev": "pnpm run generate && vite",
    "build.client": "vite build",
    "build.ssr": "vite build --ssr src/entry.ssr.tsx",
    "build.preview": "vite build --ssr src/entry.preview.tsx",
    "prerender": "node scripts/prerender.mjs",
    "build": "pnpm run generate && pnpm run build.client && pnpm run build.ssr && pnpm run build.preview && pnpm run prerender",
    "preview": "vite preview --port 4195 --strictPort",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@angular-community/qwik-cdk": "workspace:*",
    "@angular-community/qwik-material": "workspace:*",
    "@angular-community/qwik-material-examples": "workspace:*",
    "shiki": "^1.24.0",
    "markdown-it": "^14.1.0"
  },
  "devDependencies": {
    "@qwik.dev/core": "2.0.0-rc.4",
    "@qwik.dev/router": "2.0.0-rc.4",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "*",
    "typescript": "*",
    "vite": "^8.3.5",
    "ts-morph": "^24.0.0"
  }
}
