{
  "name": "@angular-community/qwik-material",
  "version": "0.0.0",
  "description": "Qwik port of @angular/material (starting with Dialog).",
  "type": "module",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint:no-ssr-leaks": "node ./scripts/lint-no-ssr-leaks.mjs"
  },
  "peerDependencies": {
    "@builder.io/qwik": "^1.5.0",
    "@angular-community/qwik-cdk": "workspace:*"
  },
  "devDependencies": {
    "@builder.io/qwik": "^1.5.0",
    "@angular-community/qwik-cdk": "workspace:*",
    "@types/node": "*",
    "happy-dom": "*",
    "sass": "*",
    "typescript": "*",
    "vite": "*",
    "vite-plugin-dts": "*",
    "vitest": "*"
  },
  "exports": {
    ".": {
      "qwik": "./index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./dialog": {
      "qwik": "./dialog/index.ts",
      "types": "./dist/dialog/index.d.ts",
      "import": "./dist/dialog/index.js"
    },
    "./button": {
      "qwik": "./button/index.ts",
      "types": "./dist/button/index.d.ts",
      "import": "./dist/button/index.js"
    },
    "./card": {
      "qwik": "./card/index.ts",
      "types": "./dist/card/index.d.ts",
      "import": "./dist/card/index.js"
    },
    "./toolbar": {
      "qwik": "./toolbar/index.ts",
      "types": "./dist/toolbar/index.d.ts",
      "import": "./dist/toolbar/index.js"
    },
    "./badge": {
      "qwik": "./badge/index.ts",
      "types": "./dist/badge/index.d.ts",
      "import": "./dist/badge/index.js"
    },
    "./icon": {
      "qwik": "./icon/index.ts",
      "types": "./dist/icon/index.d.ts",
      "import": "./dist/icon/index.js"
    },
    "./progress-bar": {
      "qwik": "./progress-bar/index.ts",
      "types": "./dist/progress-bar/index.d.ts",
      "import": "./dist/progress-bar/index.js"
    },
    "./progress-spinner": {
      "qwik": "./progress-spinner/index.ts",
      "types": "./dist/progress-spinner/index.d.ts",
      "import": "./dist/progress-spinner/index.js"
    },
    "./dialog-prebuilt.css": "./dist/dialog-prebuilt.css",
    "./button-prebuilt.css": "./dist/button-prebuilt.css",
    "./card-prebuilt.css": "./dist/card-prebuilt.css",
    "./toolbar-prebuilt.css": "./dist/toolbar-prebuilt.css",
    "./badge-prebuilt.css": "./dist/badge-prebuilt.css",
    "./icon-prebuilt.css": "./dist/icon-prebuilt.css",
    "./progress-bar-prebuilt.css": "./dist/progress-bar-prebuilt.css",
    "./progress-spinner-prebuilt.css": "./dist/progress-spinner-prebuilt.css",
    "./scss/*": "./scss/*"
  },
  "files": [
    "dist",
    "scss",
    "*.ts",
    "*.tsx",
    "**/*.ts",
    "**/*.tsx",
    "!**/*.spec.ts",
    "!**/*.spec.tsx",
    "!scripts"
  ]
}
